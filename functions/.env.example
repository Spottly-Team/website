# Copia in functions/.env e compila con i dati da Meta for Developers → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=il_tuo_token_permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Opzionale: template approvato su Meta (consigliato per messaggi automatici)
# Crea un template in italiano con 2 variabili nel corpo: {{1}} = nome, {{2}} = email
WHATSAPP_TEMPLATE_NAME=spottly_card_setup
WHATSAPP_TEMPLATE_LANGUAGE=it

# Opzionale: limita l'admin a queste email (separate da virgola)
# ADMIN_EMAILS=admin@tuodominio.it
